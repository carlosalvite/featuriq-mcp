# Your Featuriq API key (required) — get it from featuriq.io → Settings → API
FEATURIQ_API_KEY=fq_live_xxxxxxxxxxxxxxxxxxxx

# HTTP port the MCP server listens on
# Railway injects PORT automatically — only set this for local dev
PORT=3000

# Featuriq REST API base URL (default shown)
# FEATURIQ_API_URL=https://featuriq.io/v1

# Featuriq app base URL — used to build OAuth endpoint URLs in the metadata response
# FEATURIQ_APP_URL=https://featuriq.io
